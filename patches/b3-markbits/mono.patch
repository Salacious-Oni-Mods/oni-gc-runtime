diff --git a/mono/metadata/boehm-gc.c b/mono/metadata/boehm-gc.c
index 71222459..4c3790dc 100644
--- a/mono/metadata/boehm-gc.c
+++ b/mono/metadata/boehm-gc.c
@@ -2276,6 +2276,23 @@ mono_gc_strong_handle_foreach(GFunc func, gpointer user_data)
 	unlock_handles(handles);
 }
 
+/*
+ * Names this runtime as a modified build. The patch set that adds this (patches/<set>
+ * in the oni-gc-runtime repo) is built by tools/build-runtime.sh, which writes oni-gc-version.h
+ * with "<VERSION>-<set>+<commit>", and "*" appended when that tree was dirty. The stock runtime
+ * has no such export, which is how a reader tells the two apart.
+ */
+#include "oni-gc-version.h"
+
+MONO_API const char *
+oni_gc_version (void);
+
+const char *
+oni_gc_version (void)
+{
+	return ONI_GC_VERSION;
+}
+
 #else
 
 MONO_EMPTY_SOURCE_FILE (boehm_gc);
